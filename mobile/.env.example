# FloodLens Mobile Environment Configuration Example
# Set EXPO_PUBLIC_API_URL to the address your target device can reach:
#
# 1. Physical Android/iOS Device (Expo Go over Wi-Fi):
#    EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:8000 (e.g. http://192.168.29.121:8000)
#
# 2. Android Emulator (Standard Host Loopback):
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# 3. Local Web / Desktop Preview:
#    EXPO_PUBLIC_API_URL=http://localhost:8000

EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
