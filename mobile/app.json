{
  "expo": {
    "name": "FloodLens Citizen",
    "slug": "floodlens-citizen",
    "owner": "sumit7974",
    "scheme": "floodlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "ai.floodlens.citizen",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FloodLens to get your approximate location only when you choose to share it in a test help request."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "environment": "historical-demo-only",
      "eas": {
        "projectId": "81c0b727-06ad-47c4-baf4-bd654305fc7a"
      }
    }
  }
}
