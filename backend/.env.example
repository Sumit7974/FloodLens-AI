# ==============================================================================
# FloodLens AI Backend Environment Configuration Template
# Copy this file to .env and customize for your local setup.
# WARNING: NEVER commit actual .env with production secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="FloodLens AI Backend"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
WS_V1_PREFIX="/ws/v1"

# Database Configuration (PostgreSQL + PostGIS)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql+psycopg2://floodlens:floodlens_secure_password@localhost:5432/floodlens_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Fallback / Testing SQLite (Used in test suite without Postgres instance)
TEST_DATABASE_URL="sqlite:///./test_floodlens.db"

# Security & Authentication (JWT)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production-123456"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated for authority web and citizen clients)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Operational Mode
# Options: historical_demo, test, live_observation, model_estimate
OPERATIONAL_MODE="historical_demo"

# Geospatial & Storage Directories
DATA_DIR="./data"
RASTER_STORAGE_PATH="./data/rasters"
REPORTS_STORAGE_PATH="./data/reports"

# Logging
LOG_LEVEL="INFO"
