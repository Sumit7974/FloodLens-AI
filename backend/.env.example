# ==============================================================================
# FloodLens AI Deployment & Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit an actual .env containing production secrets to version control.
# 2. Outside development/testing environments, FloodLens AI actively validates and
#    REJECTS default passwords ('floodlens_secure_password') or default/short JWT secrets.
# 3. Generate a secure random JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# Application & Server Settings
APP_NAME="FloodLens AI Backend"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
WS_V1_PREFIX="/ws/v1"

# Database Configuration (PostgreSQL 16 + PostGIS 3.4)
# Production / Staging: postgresql+psycopg2://<user>:<strong_password>@<db-host>:<db-port>/<db-name>
# Local Docker Compose default:
DATABASE_URL="postgresql+psycopg2://floodlens:floodlens_secure_password@localhost:5432/floodlens_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Fallback Testing Database (Used in local test suite when live Postgres is unavailable)
TEST_DATABASE_URL="sqlite:///./test_floodlens.db"

# Security & Authentication (JWT)
# Must be at least 32 characters in staging/production.
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production-123456"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list of authority dashboards, field apps, mobile clients)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Operational Mode
# Options: historical_demo, test, live_observation, model_estimate
# Strict historical simulation boundary: prevents actual SMS/push alerts or emergency dispatch.
OPERATIONAL_MODE="historical_demo"

# Geospatial Asset & Storage Paths
FLOODLENS_REPO_ROOT="/app"
DATA_DIR="./data"
RASTER_STORAGE_PATH="./data/rasters"
REPORTS_STORAGE_PATH="./data/reports"
SATELLITE_OUTPUT_DIR="./backend/app/storage/satellite_outputs"

# Satellite Background Worker Configuration
SATELLITE_WORKER_POLL_INTERVAL=2.0
SATELLITE_WORKER_LEASE_SECONDS=60

# Logging Configuration
LOG_LEVEL="INFO"
